<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#0C1218"
                android:startColor="#1A2A3D" />
            <stroke
                android:width="1dp"
                android:color="#A56D59" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="#0F1620"
                android:startColor="#24364A" />
            <stroke
                android:width="1dp"
                android:color="#C98D72" />
        </shape>
    </item>
</selector>
