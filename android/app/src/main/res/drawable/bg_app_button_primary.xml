<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0B1320"
                android:startColor="#16263B" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#5D85AB" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#132338"
                android:startColor="#274A72" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#88B8EE" />
        </shape>
    </item>
</selector>
