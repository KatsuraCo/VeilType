<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0B1118"
                android:startColor="#152131" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#49637B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0B1320"
                android:startColor="#172536" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#5F7993" />
        </shape>
    </item>
</selector>
