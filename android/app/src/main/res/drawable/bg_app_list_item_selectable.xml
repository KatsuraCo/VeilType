<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#10253A"
                android:startColor="#17324A" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#5F93C8" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0D1723"
                android:startColor="#152638" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#486B8D" />
        </shape>
    </item>

    <item android:drawable="@drawable/bg_app_list_item" />
</selector>
