<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0B1118"
                android:startColor="#111C29" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#33465B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#0A1118"
                android:startColor="#121D2A" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#2D4256" />
        </shape>
    </item>
</selector>
