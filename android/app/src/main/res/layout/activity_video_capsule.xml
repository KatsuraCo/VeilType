<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A12"
    android:fitsSystemWindows="false">

    <FrameLayout
        android:id="@+id/videoPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#050A12" />

        <TextureView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/previewPlayOverlay"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="center"
            android:alpha="0"
            android:clickable="false"
            android:focusable="false"
            android:text="PLAY"
            android:visibility="gone" />

        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="94dp"
            android:background="@drawable/bg_capsule_play_overlay"
            android:fontFamily="monospace"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/video_capsule_timer_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/switchCameraButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_app_button_secondary"
            android:backgroundTint="@null"
            android:contentDescription="@string/video_capsule_switch_camera"
            android:padding="8dp"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/actionTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/video_action_ready_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/actionSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:text="@string/video_action_ready_subtitle"
            android:textColor="#D7E2EE"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/recordLabelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/video_capsule_record"
            android:textColor="#A6B0C3"
            android:textSize="14sp" />

        <Button
            android:id="@+id/recordButton"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_capsule_record_button"
            android:backgroundTint="@null"
            android:text="REC"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:id="@+id/videoPlaybackActionsRow"
            android:orientation="horizontal">

            <Button
                android:id="@+id/openCapsuleButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_app_button_secondary"
                android:backgroundTint="@null"
                android:text="@string/media_capsule_open"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/playButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_app_button_secondary"
                android:backgroundTint="@null"
                android:text="@string/video_capsule_play"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/videoPlaybackSeekBar"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="#8CEBFF"
            android:thumbTint="#F0D28E"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:id="@+id/videoReadyActionsRow"
            android:orientation="horizontal">

            <Button
                android:id="@+id/retakeButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="@drawable/bg_app_button_secondary"
                android:backgroundTint="@null"
                android:text="@string/video_action_retake"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/shareButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_app_button_primary"
                android:backgroundTint="@null"
                android:text="@string/media_capsule_share"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
