<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="44dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/audio_capsule_title"
            android:textColor="#F6F8FC"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/audio_capsule_subtitle"
            android:textColor="#A6B0C3"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/media_capsule_status_ready"
                android:textColor="#D7E2EE"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/timerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/audio_capsule_timer_placeholder"
                android:textColor="#F6F8FC"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recordLabelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/audio_capsule_record"
                android:textColor="#A6B0C3"
                android:textSize="14sp" />

            <Button
                android:id="@+id/recordButton"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_capsule_record_button"
                android:backgroundTint="@null"
                android:text="@string/audio_capsule_record_icon"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/openCapsuleButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_app_button_secondary"
                android:backgroundTint="@null"
                android:text="@string/media_capsule_open"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/playButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_app_button_secondary"
                android:backgroundTint="@null"
                android:text="@string/audio_capsule_play"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/shareButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_app_button_primary"
                android:backgroundTint="@null"
                android:text="@string/media_capsule_share"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
