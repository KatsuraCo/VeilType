<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="72dp">

        <TextView
            android:id="@+id/headerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_manager_title"
            android:textColor="#F6F8FC"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/profile_manager_subtitle"
            android:textColor="#A6B0C3"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_app_card"
            android:padding="14dp"
            android:text="@string/debug_status_placeholder"
            android:textColor="#D7E2EE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/createKeyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:id="@+id/profileCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_current_key_title"
            android:textColor="#F6F8FC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/selectedProfileLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/profile_manager_selected_placeholder"
            android:textColor="#A6B0C3"
            android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_my_key_title"
                android:textColor="#F6F8FC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/profile_my_key_subtitle"
                android:textColor="#A6B0C3"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/generatedEmojiText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_list_surface"
                android:padding="16dp"
                android:text="@string/profile_default_emoji_sequence"
                android:textColor="#F6F8FC"
                android:textIsSelectable="true"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/generateKeyButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_button_primary"
                    android:backgroundTint="@null"
                    android:text="@string/profile_generate_key"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/copyKeyButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_button_secondary"
                    android:backgroundTint="@null"
                    android:text="@string/profile_copy_key"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/shareKeyButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_app_button_secondary"
                    android:backgroundTint="@null"
                    android:text="@string/profile_share_key"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/saveGeneratedKeyButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_app_button_primary"
                android:backgroundTint="@null"
                android:text="@string/save_profile"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/keyExpiryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_app_button_secondary"
                android:backgroundTint="@null"
                android:text="@string/profile_expiry_default"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/keyExpiryHintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/profile_expiry_hint"
                android:textColor="#A6B0C3"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/oneTimeReadCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="#F0D28E"
                android:text="@string/profile_one_time_read"
                android:textColor="#F6F8FC"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/biometricDecryptCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#F0D28E"
                android:text="@string/profile_biometric_decrypt"
                android:textColor="#F6F8FC"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/exportAllowedCheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#F0D28E"
                android:text="@string/profile_export_allowed"
                android:textColor="#F6F8FC"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/importKeyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_remote_key_title"
                android:textColor="#F6F8FC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/profile_remote_key_subtitle"
                android:textColor="#A6B0C3"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/importKeyInput"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_app_input"
                android:gravity="top"
                android:hint="@string/profile_import_key_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="3"
                android:padding="16dp"
                android:textColor="#F6F8FC"
                android:textColorHint="#A6B0C3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/importKeyButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_app_button_secondary"
                    android:backgroundTint="@null"
                    android:text="@string/profile_import_key"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/saveImportedKeyButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_app_button_primary"
                android:backgroundTint="@null"
                android:text="@string/save_profile"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/manualKeyEditCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_app_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible">

            <EditText
                android:id="@+id/titleInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:autofillHints="personName"
                android:background="@drawable/bg_app_input"
                android:gravity="center_vertical"
                android:hint="@string/profile_title_hint"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#F6F8FC"
                android:textColorHint="#A6B0C3" />

            <EditText
                android:id="@+id/peerHintInput"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:visibility="gone" />

            <EditText
                android:id="@+id/appPackageInput"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:visibility="gone" />

            <EditText
                android:id="@+id/emojiSequenceInput"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_app_input"
                android:gravity="center_vertical"
                android:hint="@string/profile_emoji_sequence_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#F6F8FC"
                android:textColorHint="#A6B0C3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/createProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_button_primary"
                    android:backgroundTint="@null"
                    android:text="@string/save_profile"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/resetFormButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_button_secondary"
                    android:backgroundTint="@null"
                    android:text="@string/profile_new_key"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/renewProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_button_secondary"
                    android:backgroundTint="@null"
                    android:text="@string/profile_action_renew"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/archiveProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_button_secondary"
                    android:backgroundTint="@null"
                    android:text="@string/profile_action_archive"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/deleteProfileButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_button_secondary"
                    android:backgroundTint="@null"
                    android:text="@string/profile_action_delete"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/clearProfilesButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_app_button_tonal"
                    android:backgroundTint="@null"
                    android:text="@string/clear_profiles"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/selectedProfileIdInput"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0"
            android:focusable="false"
            android:hint="@string/profile_selected_id_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/savedKeysTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/profile_old_keys_title"
            android:textColor="#F6F8FC"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/savedKeysSubtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/profile_old_keys_subtitle"
            android:textColor="#A6B0C3"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/profileListSurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_app_list_surface"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:id="@+id/profileListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <Button
            android:id="@+id/deleteOldKeysButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_app_button_secondary"
            android:backgroundTint="@null"
            android:text="@string/profile_delete_old_keys"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

