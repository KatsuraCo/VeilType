<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/headerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/profile_manager_title"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/headerSubtitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/profile_manager_subtitle"
        android:textColor="#AFC1D3"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/debug_status_placeholder"
        android:textColor="#DCEAF8"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_premium_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/profileCountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile_count_placeholder"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/selectedProfileLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/profile_manager_selected_placeholder"
            android:textColor="#AFC1D3" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_premium_card"
        android:orientation="vertical"
        android:padding="14dp">

        <EditText
            android:id="@+id/titleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#4F7AA1"
            android:hint="@string/profile_title_hint"
            android:inputType="textPersonName"
            android:textColor="#FFFFFF"
            android:textColorHint="#8FB0CB" />

        <EditText
            android:id="@+id/appPackageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4F7AA1"
            android:hint="@string/profile_app_package_hint"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#8FB0CB" />

        <EditText
            android:id="@+id/peerHintInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4F7AA1"
            android:hint="@string/profile_peer_hint"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#8FB0CB" />

        <EditText
            android:id="@+id/emojiSequenceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#4F7AA1"
            android:hint="@string/profile_emoji_sequence_hint"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#8FB0CB" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/createProfileButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:text="@string/create_profile"
                android:textAllCaps="false"
                android:textColor="#102030"
                android:textStyle="bold" />

            <Button
                android:id="@+id/resetFormButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="@string/reset_form"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/renewProfileButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="@string/profile_action_renew"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/archiveProfileButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="@string/profile_action_archive"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/deleteProfileButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="@string/profile_action_delete"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/clearProfilesButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_secondary_button"
            android:text="@string/clear_profiles"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <EditText
        android:id="@+id/selectedProfileIdInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:focusable="false"
        android:hint="@string/profile_selected_id_hint"
        android:inputType="text"
        android:visibility="gone" />

    <ListView
        android:id="@+id/profileListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_premium_card"
        android:choiceMode="singleChoice"
        android:divider="#264663"
        android:dividerHeight="1dp"
        android:padding="8dp" />

</LinearLayout>
